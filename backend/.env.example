# Copy these variable names into Render's service environment settings.
# Use the Neon pooled endpoint for DB_URL and the direct endpoint for Flyway.

DB_URL=jdbc:postgresql://<NEON_POOLER_HOST>/<DATABASE>?sslmode=require
DB_USERNAME=<NEON_ROLE_USERNAME>
DB_PASSWORD=
FLYWAY_DB_URL=jdbc:postgresql://<NEON_DIRECT_HOST>/<DATABASE>?sslmode=require
FLYWAY_DB_USERNAME=<NEON_ROLE_USERNAME>
FLYWAY_DB_PASSWORD=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
SENTINEL_AI_ENABLED=false
TRACING_SAMPLING_PROBABILITY=0
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=

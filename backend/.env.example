# Copy these variable names into Railway's service variables.
# Use the Neon pooled connection string (host, database, username and password).

DB_URL=jdbc:postgresql://<NEON_POOLER_HOST>/<DATABASE>?sslmode=require
DB_USERNAME=<NEON_USERNAME>
DB_PASSWORD=
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
SENTINEL_AI_ENABLED=false
# Set only when a reachable Ollama-compatible provider is configured.
# SENTINEL_AI_BASE_URL=https://<AI-PROVIDER-HOST>
TRACING_SAMPLING_PROBABILITY=0.1
# Set only when a reachable Zipkin-compatible collector is configured.
# ZIPKIN_ENDPOINT=https://<ZIPKIN-COLLECTOR>/api/v2/spans
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=
